{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(findstr:*)",
      "Bash(mkdir:*)",
      "Bash(echo:*)",
      "Bash(node:*)",
      "Bash(python:*)",
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(npm test:*)",
      "Bash(npm ci:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vite:*)",
      "Bash(npx next:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm test:*)",
      "Bash(yarn run:*)",
      "Bash(yarn install:*)",
      "Bash(yarn test:*)",
      "Bash(tsc:*)",
      "Bash(vite:*)",
      "Bash(next:*)",
      "Bash(eslint:*)",
      "Bash(prettier:*)",
      "PowerShell(Get-ChildItem:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(npm run:*)",
      "PowerShell(npm test:*)",
      "Read",
      "Glob",
      "Grep"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format.mjs\"",
            "timeout": 30,
            "statusMessage": "Biçimlendiriliyor..."
          }
        ]
      }
    ]
  }
}
